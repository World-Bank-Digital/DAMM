# Secrets — never committed. The pipeline reads vendor keys from a local .env
# (standing decision 3: keys live on disk, never in a transcript, never in git).
.env
.env.*
!.env.example

# Build scratch and OS cruft — never source of record.
__pycache__/
*.pyc
.DS_Store
.~lock*#

# LibreOffice recalc leftovers
.~lock.*

# Local virtualenv for the research pipeline (vendor SDKs). Never source of record.
.venv/

# Shadow-run resume checkpoints. Redundant with the run's own outputs — the rows are in
# <run>_input.json and the full records in <run>_research.json — and only useful while a
# run is in flight. The audition's state file is NOT ignored: it holds the page text each
# fabrication verdict was measured against, which cannot be recovered without paying for
# the run again.
*_shadow_state.json

# Historical machine-challenge and canonical challenge resume checkpoints.
# Both are redundant with the run's own findings file.
*_g2_state.json
*_automated_challenge_state.json
